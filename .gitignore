# ════════════════════════════════════════════════════════════════════════
# E Doctor — .gitignore
# ════════════════════════════════════════════════════════════════════════

# ── CRITICAL: Secret environment variables — NEVER commit these ──────────
.env
.env.local
.env.production
.env.staging
*.env

# ── Node.js dependencies ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / Editor artifacts ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Build / dist outputs ──────────────────────────────────────────────────
dist/
build/
.next/
out/

# ── Logs ─────────────────────────────────────────────────────────────────
logs/
*.log

# ── Misc ─────────────────────────────────────────────────────────────────
.cache/
.tmp/
*.tmp
