# ════════════════════════════════════════════════════════════════════════
# E Doctor — Environment Variables Template
# ════════════════════════════════════════════════════════════════════════
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real API keys in .env
#   3. Never commit .env — only commit this .env.example file
# ════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Google Gemini API ────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Infermedica API ──────────────────────────────────────────────────────
# Get credentials at: https://developer.infermedica.com/
INFERMEDICA_APP_ID=
INFERMEDICA_APP_KEY=

# ── OpenAI API ───────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── OpenFDA API (optional rate-limit key) ────────────────────────────────
OPENFDA_API_KEY=

# ── Exchange Rate API (optional) ─────────────────────────────────────────
EXCHANGE_RATE_API_KEY=

# ════════════════════════════════════════════════════════════════════════
# End of .env.example
# ════════════════════════════════════════════════════════════════════════
